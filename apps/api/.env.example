# Copy to apps/api/.env and paste your Neon connection string.
# .env is gitignored — never commit the real value. In production this is set
# as a Cloudflare Worker secret, not from this file (see wrangler.toml).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Optional local dev port (defaults to 8787)
# PORT=8787
